-- Q1. Display first_name, last_name using aliases "First Name", "Last Name"
SELECT first_name AS 'First Name', last_name AS 'Last Name'
FROM employees;

-- Q2. Get unique department IDs from employees table
SELECT DISTINCT department_id
FROM employees;

-- Q3. Get all employee details ordered by first name, descending
SELECT *
FROM employees
ORDER BY first_name DESC;

-- Q4. Get names, salary and PF (15% of salary) of all employees
SELECT first_name, last_name, salary, salary * 0.15 AS PF
FROM employees;

-- Q5. Get employee ID, names, salary in ascending order of salary
SELECT employee_id, first_name, last_name, salary
FROM employees
ORDER BY salary ASC;

-- Q6. Get the total salaries payable to employees
SELECT SUM(salary) AS total_salary
FROM employees;

-- Q7. Get the maximum and minimum salary from employees table
SELECT MAX(salary) AS max_salary, MIN(salary) AS min_salary
FROM employees;

-- Q8. Get the average salary and number of employees
SELECT AVG(salary) AS average_salary, COUNT(*) AS number_of_employees
FROM employees;

-- Q9. Get the number of employees working with the company
SELECT COUNT(*) AS total_employees
FROM employees;

-- Q10. Get the number of jobs available in the employees table
SELECT COUNT(DISTINCT job_id) AS number_of_jobs
FROM employees;

-- Q11. Get all first names from employees table in upper case
SELECT UPPER(first_name) AS first_name_upper
FROM employees;

-- Q12. Get the first 3 characters of first name from employees table
SELECT SUBSTRING(first_name, 1, 3) AS first_three_chars
FROM employees;

-- Q13. Calculate 171*214+625
SELECT 171 * 214 + 625 AS result;

-- Q14. Get full names (e.g. Ellen Abel) of all employees
SELECT CONCAT(first_name, ' ', last_name) AS full_name
FROM employees;

-- Q15. Get first name after removing white spaces from both sides
SELECT TRIM(first_name) AS first_name_trimmed
FROM employees;

-- Q16. Get the length of the employee names (first_name, last_name)
SELECT first_name, last_name,
       LENGTH(first_name) + LENGTH(last_name) AS name_length
FROM employees;

-- Q17. Check if the first_name field contains numbers
SELECT *
FROM employees
WHERE first_name REGEXP '[0-9]';

-- Q18. Select first 10 records from a table
SELECT *
FROM employees
LIMIT 10;

-- Q19. Get monthly salary (rounded to 2 decimal places) of each employee  (salary is annual)
SELECT employee_id, first_name, last_name,
       ROUND(salary / 12, 2) AS monthly_salary
FROM employees;


